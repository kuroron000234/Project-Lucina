{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "build": {
      "model": "ollama/gemma4:e4b",
      "temperature": 0.7,
      "steps": 10
    },
    "plan": {
      "model": "ollama/gemma4:e4b",
      "temperature": 0.7,
      "steps": 10
    }
  },
  "command": {
    "test": {
      "template": "python3 -m pytest tests/ -v --tb=short",
      "description": "Run all tests"
    },
    "validate": {
      "template": "python3 main.py --validate --phase 2",
      "description": "Run one validation cycle"
    },
    "message": {
      "template": "python3 main.py --message \"${input}\"",
      "description": "Send a message to Lucina"
    }
  }
}
